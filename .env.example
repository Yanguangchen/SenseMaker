# --- AI providers -------------------------------------------------------------
# One Gemini key and one OpenAI key power every AI feature: Sentiment Analysis
# and GenCite. Keys stay on the server; dashboard users never enter them.
# Configure one or both. A feature whose provider has no key is skipped.
AI_PROVIDER=gemini
# Google Gemini. GEMINI_API_KEY (the name the GenCite web app uses) also works.
GEMINI_KEY=
GEMINI_MODEL=auto
# OpenAI, shown as ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# GenCite (AI share of voice) reuses the two keys above; it needs no keys of its own.
# Optional model overrides. Leave blank to use the GenCite web app's models,
# gemini-2.5-flash and gpt-4.1-mini, so results stay comparable between the apps.
# GENCITE_GEMINI_MODEL also accepts auto (an available Flash model).
GENCITE_GEMINI_MODEL=
GENCITE_OPENAI_MODEL=

# Optional Thai-linked project/brand names and aliases, one per line in a quoted value.
THAILAND_WATCH_TERMS=0LtX
FIREBASE_PROJECT_ID=project-sentinel-9ab8e
FIREBASE_COLLECTION=raw_posts

# Same Firebase web configuration and complete approved-user list as OYOSHI.
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=project-sentinel-9ab8e.firebaseapp.com
FIREBASE_APP_ID=your_firebase_web_app_id
FAQ_EDITOR_EMAILS=editor1@example.com,editor2@example.com

# Server Admin SDK: use a service-account file, the [firebase] Streamlit table,
# OYOSHI's FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY, or ADC.
FIREBASE_CREDENTIALS=path/to/firebase-service-account.json
# Railway: leave FIREBASE_CREDENTIALS unset and configure these server variables.
# FIREBASE_PRIVATE_KEY accepts literal \\n escapes or a quoted multiline value.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

TARGET_GROUP_URL=https://www.facebook.com/groups/example
HEADLESS=false

# Hosted Facebook login: configure Browserbase credentials in Railway Variables.
# Each approved Google account gets a private persistent browser profile.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Approved Reddit Data API app credentials. Keep these on the server.
# User agent format: platform:app:version (by /u/your_reddit_username)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
# Optional read-scope refresh token if your approved app uses user authorization.
REDDIT_REFRESH_TOKEN=
