GEMINI_KEY=your_gemini_api_key_here
GEMINI_MODEL=auto
# Optional Thai-linked project/brand names and aliases, one per line in a quoted value.
THAILAND_WATCH_TERMS=
FIREBASE_PROJECT_ID=project-sentinel-9ab8e
FIREBASE_COLLECTION=raw_posts

# Same Firebase web configuration and complete approved-user list as OYOSHI.
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=project-sentinel-9ab8e.firebaseapp.com
FIREBASE_APP_ID=your_firebase_web_app_id
FAQ_EDITOR_EMAILS=editor1@example.com,editor2@example.com

# Server Admin SDK: use a service-account file, the [firebase] Streamlit table,
# OYOSHI's FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY, or ADC.
FIREBASE_CREDENTIALS=path/to/firebase-service-account.json

TARGET_GROUP_URL=https://www.facebook.com/groups/example
HEADLESS=false

# Approved Reddit Data API app credentials. Keep these on the server.
# User agent format: platform:app:version (by /u/your_reddit_username)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
# Optional read-scope refresh token if your approved app uses user authorization.
REDDIT_REFRESH_TOKEN=
